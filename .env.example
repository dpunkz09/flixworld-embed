# JW Player license key
NEXT_PUBLIC_JW_LICENSE_KEY=

# TMDB API key (server-side only)
TMDB_API_KEY=

# Cloudflare Worker proxy URL for HLS streams
# Deploy the Cloudflare Worker first, then add its URL here
NEXT_PUBLIC_HLS_PROXY=

# Optional: Subtitle proxy API key (if using api.flixworld.xyz for subtitles)
# Note: VidNest API includes subtitles directly, so this may not be needed
STREAM_API_KEY=

