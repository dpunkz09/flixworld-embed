# JW Player license key
NEXT_PUBLIC_JW_LICENSE_KEY=

# TMDB API key (server-side only)
TMDB_API_KEY=

# Subtitle proxy API key (for api.flixworld.xyz requests)
STREAM_API_KEY=

# fw-api base URL — use localhost when the API runs on the same server.
# Server-side only (no NEXT_PUBLIC_ prefix) so the URL is never sent to clients.
# Production default falls back to the public domain if unset.
FW_API_BASE=http://localhost:4444

# Internal token that guards /api/stream from public access.
# Both vars must be set to the same value.
# Regenerate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=your-secret-token-here
NEXT_PUBLIC_INTERNAL_API_TOKEN=your-secret-token-here
