# JW Player license key
NEXT_PUBLIC_JW_LICENSE_KEY=

# TMDB API key (server-side only - for metadata like posters, descriptions)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Vidsrc.sh Configuration
# Vidsrc returns fully tokenized M3U8 URLs with proper CORS headers
# No proxy or additional API keys needed! Streams work directly.
